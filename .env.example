# OpenAI-compatible multimodal endpoint.
MODEL_BASE_URL=https://your-model-server.example/v1
MODEL_MODEL=qwen3-vl
MODEL_API_KEY=empty

# Required: the runner never guesses which device to drive.
ADB_DEVICE=emulator-5554
# ADB_PATH=adb

# --- Serving on Ollama -----------------------------------------------------
# Ollama's tool-call parser scans *prompt* text for <tool_call> tags even when
# the request declares no tools, and answers 500 {"error":"EOF"} when it finds
# them (ollama/ollama#14986; fix PR #15011 still open). The system prompt
# carries those tags and so does every replayed assistant turn, so a run dies
# on the first request and would die on the second even with a clean prompt.
#
# Setting this to 1 rewrites them to [tool_call]...[/tool_call] on the way out;
# the parser reads either spelling back. Leave it off for vLLM or SGLang, which
# serve the tags the model was trained on.
# MODEL_ESCAPE_TOOL_CALLS=1

# --- Optional tuning -------------------------------------------------------
# Screenshots are downscaled to the model's training resolution (1003520 px for
# Qwen3-VL) because sending more pixels than that grounds *worse*. Set a
# positive value to override, or a negative one to disable downscaling.
# MODEL_MAX_IMAGE_PIXELS=0

# Thinking is off by default: the reasoning is 58% of a reply and never changes
# the next decision. 1 switches the prompt back on and stops sending
# reasoning_effort=none.
# MODEL_THINKING=0
# MODEL_REASONING_EFFORT=auto   # auto | none | low | medium | high

# Reflection is on by default: two short Check/Expect lines inside the actor
# call, not a reasoning block and not the independent --success checker.
# Requires MODEL_HISTORY_N of at least 2. 0 turns it off.
# MODEL_REFLECTION=1

# After every action the runner screenshots until two consecutive frames are
# identical, so the model is shown a drawn screen rather than one mid-transition.
# This is the cap on that wait, not a fixed delay: a still screen costs one poll.
# 0 turns the polling off and takes a single frame, as every run did before.
# MODEL_SETTLE_TIMEOUT_S=3

# No app is force-stopped unless one is named here. Setting it makes each run
# start from a cold launcher, which buys isolation from the previous run's
# leftover dialog and costs the agent a turn opening the app again.
# APP_PACKAGE=com.example.other

# MODEL_TIMEOUT_S=180
# MODEL_HISTORY_N=3      # total screenshots per request, current one included
# MODEL_TEMPERATURE=0
# MODEL_MAX_TOKENS=2048
# MODEL_STEP_SLEEP=1
# ADB_TIMEOUT_S=30       # also caps a hold: see "Hold time" in the README
# ADB_LONG_PRESS_MS=1000 # fallback only; the instruction and the model win
